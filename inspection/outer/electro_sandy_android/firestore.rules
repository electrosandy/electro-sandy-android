rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in account can access only its own shop namespace.
    match /shops/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Deny access to every document outside the shop namespace.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
